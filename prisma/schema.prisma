generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  tasks Task[]
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      Status   @default(PENDING)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      Int
  createdAt   DateTime @default(now())
}

enum Status {
  PENDING
  DONE
}